# Sentinel - Environment Variables
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────────
# Supabase (Required)
# ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ──────────────────────────────────────────────────
# WalletConnect (Optional)
# ──────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ──────────────────────────────────────────────────
# Blockchain API Providers (Server-side only)
# These are used by API routes and are NOT exposed to the client.
# You can use either naming convention - both work:
#   COVALENT_API_KEY=xxx  OR  COVALENT=xxx
# ──────────────────────────────────────────────────
COVALENT_API_KEY=your-covalent-api-key
ZERION_API_KEY=your-zerion-api-key
ALCHEMY_API_KEY=your-alchemy-api-key
DEBANK_API_KEY=your-debank-api-key
ETHERSCAN_API_KEY=your-etherscan-api-key

# ──────────────────────────────────────────────────
# Alchemy Webhooks (Optional - for real-time updates)
# ──────────────────────────────────────────────────
ALCHEMY_WEBHOOK_SECRET=your-alchemy-webhook-secret

# ──────────────────────────────────────────────────
# Pricing Layer (see docs/sentinel-ai/09-pricing-layer.md)
#
# Failover: spot = Alchemy -> CoinGecko -> DefiLlama
#           historical = DefiLlama -> CoinGecko
# DefiLlama needs no credentials, so historical pricing works out of the box.
# ──────────────────────────────────────────────────
COINGECKO_API_KEY=your-coingecko-api-key
# demo (default, api.coingecko.com) or pro (pro-api.coingecko.com)
COINGECKO_API_TIER=demo

# All of the following are optional and have production-safe defaults.
# Promote one provider to the front of a failover chain:
# PRICING_HISTORICAL_PROVIDER=defillama
# PRICING_SPOT_PROVIDER=alchemy
# PRICING_MAX_CONCURRENCY=4              # concurrent calls per provider
# PRICING_REQUEST_TIMEOUT_MS=10000       # hard timeout per HTTP call
# PRICING_MAX_RETRIES=2                  # retries on 408/429/5xx/network
# PRICING_RETRY_BASE_DELAY_MS=400
# PRICING_RETRY_MAX_DELAY_MS=4000
# PRICING_SPOT_MEMORY_TTL_MS=60000
# PRICING_SPOT_PERSISTENT_TTL_MS=300000
# PRICING_HISTORICAL_MEMORY_TTL_MS=3600000
# PRICING_MEMORY_MAX_ENTRIES=5000
# PRICING_BUCKET_HISTORICAL_TO_DAY=true  # round historical lookups to UTC day
# PRICING_PERSISTENT_CACHE=true          # use the Supabase blockchain_cache tier
# PRICING_VERBOSE=false                  # log a usage summary per pricing call

# ──────────────────────────────────────────────────
# Email (Optional - for notifications)
# ──────────────────────────────────────────────────
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your-aws-access-key
AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-key
EMAIL_FROM=notifications@yoursite.com

# ──────────────────────────────────────────────────
# Telegram (Optional - for bot notifications)
# ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ──────────────────────────────────────────────────
# AI / LLM (Optional — enables LLM narrative path)
# Without a key, Sentinel still returns full deterministic analysis.
#
# OpenAI:
#   OPENAI_API_KEY=sk-...
#   # OPENAI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#   AI_MODEL_REPORT=gpt-4o
#
# OpenRouter (OpenAI-compatible):
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=openai/gpt-4o-mini
#   AI_MODEL_REPORT=openai/gpt-4o
# ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_MODEL_REPORT=openai/gpt-4o
# AI_TIMEOUT_MS=30000
